+        // LKCT can accumulate hundreds of unlocked coinbase outputs very quickly on a
+        // young chain. Trying to spend the whole balance in one transaction may exceed
+        // wallet/core transaction construction limits even when transfer_split is used.
+        // Drain large LKCT balances in deterministic chunks and persist each successful
+        // chunk separately. If a later chunk fails, only the already-broadcast chunks
+        // are deducted and the remainder stays payable on the next run.
+        const decimal lkctMaxChunk = 500m;
+        if(string.Equals(coin.Symbol, "LKCT", StringComparison.OrdinalIgnoreCase) &&
+            balances.Any(x => x.Amount > lkctMaxChunk))
+        {
+            foreach(var balance in balances.Where(x => x.Amount > 0))
+            {
+                var remaining = balance.Amount;
+
+                while(remaining > 0)
+                {
+                    var chunkAmount = Math.Min(remaining, lkctMaxChunk);
+                    var chunk = new Balance
+                    {
+                        PoolId = balance.PoolId,
+                        Address = balance.Address,
+                        Amount = chunkAmount,
+                        Created = balance.Created,
+                        Updated = balance.Updated
+                    };
+
+                    logger.Info(() => $"[{LogCategory}] LKCT chunked payout: {FormatAmount(chunkAmount)} of {FormatAmount(remaining)} remaining for {balance.Address}");
+
+                    if(!await PayoutBatchCore(new[] { chunk }, coin, ct))
+                        return false;
+
+                    remaining -= chunkAmount;
+                }
+            }
+
+            return true;
+        }
+
+        return await PayoutBatchCore(balances, coin, ct);
+    }
